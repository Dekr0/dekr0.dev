---
export const prerender = true;

import Anchor from "@components/Anchor.astro";
import Header from "@components/Header.astro";
import HistoryPrompt from "@components/HistoryPrompt.astro";
import Line from "@components/Line.astro";
import Zen from "@components/Zen.astro";

import Layout from "@layouts/Layout.astro";

import initLine from "src/line.ts";
import quotes from "src/quote.ts";

import { open_source, reinvent_wheel, legacy_school_projects } from "src/projects.ts";

let line = initLine();
---

<Layout title="Project">
    <Zen>
        <p class="pt-2 text-solar-green-500 italic font-mono text-justify text-base" >
            "{quotes()}"
        </p>
        <section id="project" class="flex flex-col gap-4">
            <Line line={line}>
                <HistoryPrompt buffer="man project" />
            </Line>

            <Line line={line}>
                <h1 class="text-solar-blue-300 font-bold w-fit"># Project</h1>
            </Line>

            <Line line={line}>
                <p>The "Reinvent The Wheel" and "Legacy School Projects" only 
                    contain a small subset of my projects. The full list and more 
                    detail description for each project is still under 
                    construction. Currently, I'm only focus on the open source 
                    section since this is what I'm actively working on.
                </p>
            </Line>

            <div class="flex flex-col gap-4">
                <Line line={line}>
                    <h2 class="text-solar-blue-300 font-bold w-fit">
                        ## Open Source
                    </h2>
                </Line>
                {open_source.map((o) => 
                    <Line line={line}> 
                        <h3 class="font-bold w-fit">
                            <Anchor href={o.url}>### {o.name}</Anchor>
                        </h3>
                    </Line>
                    <Line line={line}>
                        <p class="text-justify">{o.p}</p>
                    </Line>
                )}
            </div>

            <div class="flex flex-col gap-4">
                <Line line={line}>
                    <h2 class="text-solar-blue-300 font-bold w-fit">
                        ## "Reinvent The Wheel"
                    </h2>
                </Line>
                {reinvent_wheel.map((r) => 
                    <Line line={line}> 
                        <h3 class="font-bold w-fit">
                            <Anchor href={r.url}>### {r.name}</Anchor>
                        </h3>
                    </Line>
                    <Line line={line}>
                        <p class="text-justify">{r.p}</p>
                    </Line>
                )}
            </div>

            <div class="flex flex-col gap-4">
                <Line line={line}>
                    <h2 class="text-solar-blue-300 font-bold w-fit">
                        ## Legacy School Projects
                    </h2>
                </Line>
                {legacy_school_projects.map((r) => 
                    <Line line={line}> 
                        <h3 class="font-bold w-fit">
                            <Anchor href={r.url}>### {r.name}</Anchor>
                        </h3>
                    </Line>
                    <Line line={line}>
                        <p class="text-justify">{r.p}</p>
                    </Line>
                )}
            </div>
        </section>
    </Zen>
    <Header title="project" />
</Layout>
