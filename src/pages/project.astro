---
export const prerender = true;

import Anchor from "../components/Anchor.astro";
import Header from "../components/Header.astro";
import HistoryPrompt from "../components/HistoryPrompt.astro";
import Line from "../components/Line.astro";
import Layout from "../layouts/Layout.astro";
import Zen from "../components/Zen.astro";

import initLine from "../line.mts";
import quotes from "../quote.mts";

let line = initLine();
---

<Layout title="Project">
    <Zen>
        <p class="pt-2 text-solar-green-500 italic font-mono text-justify text-base" >
            "{quotes()}"
        </p>
        <section id="project" class="flex flex-col gap-4">
            <Line line={line}>
                <HistoryPrompt buffer="man project" />
            </Line>

            <Line line={line}>
                <h1 class="text-solar-blue-300 font-bold w-fit"># Project</h1>
            </Line>

            <div class="flex flex-col gap-4">
                <Line line={line}>
                    <h2 class="text-solar-blue-300 font-bold w-fit">
                        ## Open Source
                    </h2>
                </Line>
    
                <Line line={line}>
                    <h3 class="font-bold w-fit">
                        <Anchor href="https://github.com/Dekr0/RPC.nvim">
                            ### RPC.nvim
                        </Anchor>
                    </h3>
                </Line>
                <Line line={line}>
                    <p class="text-justify">
                        RPC.nvim is a Neovim plugin that integrates Discord Rich
                        Presence, displaying live status (keystroke per minute, 
                        editor mode, current workspace, etc) update from Neovim 
                        and directly to users' Discord profiles.
                    </p>
                </Line>

                <Line line={line}>
                    <h3 class="font-bold w-fit">
                        <Anchor href="https://github.com/Dekr0/8086-sim">
                            ### 8086 Simulator
                        </Anchor>
                    </h3>
                </Line>
                <Line line={line}>
                    <p class="text-justify">
                        8086 simulator is a set of tools for 8086 instructions 
                        set that capable of dissembling binary assembly code, 
                        simulating instructions execution, and outputting 
                        dissemble result and simulation result. An TUI 
                        visualizer similar to GDB is provided to display the 
                        internal state of the virtual 8086 CPU and the 1 MB 
                        virtual memory.
                    </p>
                </Line>
            </div>

            <div class="flex flex-col gap-4">
                <Line line={line}>
                    <h2 class="text-solar-blue-300 font-bold w-fit">
                        ## "Reinvent The Wheel"
                    </h2>
                </Line>

                <Line line={line}>
                    <h3 class="font-bold w-fit">
                        <Anchor href="https://github.com/Dekr0/c-http">
                            ### HTTP Server
                        </Anchor>
                    </h3>
                </Line>
                <Line line={line}>
                    <p class="text-justify">
                    a HTTP server written in C, capable of parsing HTTP message 
                    efficiently, perform simple dynamic endpoint routing, and 
                    handling multiple concurrent client connections.
                    </p>
                </Line>

                <Line line={line}>
                    <h3 class="font-bold w-fit">
                        <Anchor href="https://github.com/Dekr0/redis-clone">
                            ### Redis Clone
                        </Anchor>
                        </a>
                    </h3>
                </Line>
                <Line line={line}>
                    <p class="text-justify">
                        a working in progress Redis Clone written in C, mirroring 
                        essential Redis functionalities.
                    </p>
                </Line>
            </div>
        </section>
    </Zen>
    <Header title="project" />
</Layout>
