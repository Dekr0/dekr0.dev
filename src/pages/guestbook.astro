---
import { GET } from "@apis/guestbook";
import Anchor from "@components/Anchor.astro";
import CommentForm from "@components/CommentForm.astro";
import Header from "@components/Header.astro";
import HistoryPrompt from "@components/HistoryPrompt.astro";
import Line from "@components/Line.astro";
import Layout from "@layouts/Layout.astro";
import Zen from "@components/Zen.astro";

import initLine from "src/line.mts";
import quotes from "src/quote.mts";
import getLogger from "src/logger";
import { type Comment } from "src/db";

const user = Astro.locals.user;

let line = initLine();
const start = Date.now();
const logger = getLogger().child({ filename: "/pages/guestbook" });

let comments: Comment[] | undefined;
try {
    const result = await GET(Astro);
    comments = await result.json();
} catch(e) {
    logger.error(e);
}
---
<Layout title="Guestbook">
    <Zen>
        <p
            class="pt-2 text-solar-green-500 italic font-mono text-justify text-base"
        >
            "{quotes()}"
        </p>

        <section id="guestbook" 
            class="flex flex-col gap-4 text-justify hide">
            <Line line={line}>
                <HistoryPrompt buffer="guestbook sign --dry-run || guestbook signin & \\" />
            </Line>

            <Line line={line}>
                <p>guestbook list</p>
            </Line>

            <Line line={line}>
                <p>[1] {Math.floor(Math.random() * 50000)}</p>
            </Line>

            {!user ?
                <Line line={line}>
                    <p>guestbook sign --dry-run: Login required</p>
                </Line>
                <Line line={line}>
                    <p>[1] + done guestbook sign --dry-run</p>
                </Line>

                <Line line={line}>
                    <Anchor href="/api/auth/oauth/github" notblank={true}> 
                        <span>{"\ue708"}</span> <span>GitHub</span>
                    </Anchor>
                </Line>
                :
                <Line line={line}>
                    <p>[1] + done guestbook sign --dry-run</p>
                </Line>
                <CommentForm line={line} start={start} />
            }

            <div id="line-ref">
               <ul id="comments" class="flex flex-col gap-4 content-center">
               {
                   comments !== undefined &&
                    <div id="line-ref">
                       <ul id="comments" class="flex flex-col gap-4 content-center">
                           {comments.map((comment) => <li id={comment.comment_id}>
                               <Line line={line}>
                               <p>
                                   <span class="text-solar-cyna-300">
                                       {comment.comment_author}
                                   </span>: {comment.comment}
                               </p>
                               {
                                   user && 
                                   user.id === comment.comment_author_uid && 
                                   <button 
                                       id={comment.comment_id}
                                       data-authoruid={comment.comment_author_uid}
                                       data-comment-delete
                                   >󰆴</button>
                               }
                               </Line>
                           </li>)}
                       </ul>
                    </div>
               }
               </ul>
            </div>
        </section>
    </Zen>
    <Header title="guestbook" />
</Layout>
<script>
type CommentView = {
    comment_id: string,
    comment_author: string,
    comment: string,
    comment_time: number,
    comment_author_uid: string
};

window.addEventListener("DOMContentLoaded", () => {
    const section = document.getElementById("guestbook");
    if (!section) 
        throw new Error("Unexpected UI error");

    const lineRef = document.getElementById("line-ref");
    const commentsList = document.getElementById("comments");

    let sse = new EventSource("/api/guestbook_event");
    sse.addEventListener("message", onMessage);

    const stdin = document.querySelector("input");
    const authorUid = stdin?.dataset.authoruid;
    if (!stdin) return;

    const btns = document.querySelectorAll("[data-comment-delete]");
    btns.forEach((btn) => {
        if (!authorUid) throw new Error("Unexpected UI error");
        if ((btn as HTMLButtonElement).dataset.authoruid !== authorUid)
            throw new Error("Unexpected UI error");
        btn.addEventListener("click", (e) => {
            if (!e.target) throw new Error("Unexpected UI error");
            deleteComment(authorUid, (e.target as HTMLButtonElement).id);
        });
    })

    async function deleteComment(authorUid: string, commentId: string) {
        const params = new URLSearchParams();
        params.set("comment_author_uid", authorUid);
        params.set("comment_id", commentId);

        const headers: HeadersInit = {
            Accept: "application/json",
            "Content-Type": "application/x-www-form-urlencoded",
        };
        
        const req: RequestInit = {
            mode: "same-origin",
            body: params,
            method: "DELETE",
            headers: headers,
        };        
        
        try {
            const res = await fetch("/api/guestbook", req);
            const latestComments: CommentView[] = await res.json();
            sse.close();
            refreshComments(latestComments);
            sse = new EventSource("/api/guestbook_event");
            sse.addEventListener("message", onMessage);
        } catch(e) {
            console.log(e);
        }
    }

    function refreshComments(comments: CommentView[]) {
        if (!commentsList || !lineRef) throw new Error("Unexpected UI error");

        let prevLine = lineRef.previousElementSibling;
        if (!prevLine) throw new Error("Unexpected UI error");

        const lineNumE = prevLine.querySelector("span");
        if (!lineNumE || !lineNumE.textContent) throw new Error("Unexpected UI error");

        let lineNum = parseInt(lineNumE.textContent) + 1;

        commentsList.innerHTML = "";

        for (const comment of comments) {
            const commentE = document.createElement("li");
            commentE.id = comment.comment_id
            commentE.dataset.time = comment.comment_time.toString(10);
            const div = document.createElement("div");
            div.tabIndex = 0;
            div.className = "flex gap-4 md:gap-8 lg:gap-10 pl-2 items-center hover:border-solar-orange-500 hover:border-l-2";
            div.innerHTML = `
                    <span class="text-solar-yellow-700 pl-2 text-center self-start">
                        ${lineNum++}
                    </span>
                    <p><span class="text-solar-cyna-300">${comment.comment_author}</span>: ${comment.comment}</p>
            `;

            if (stdin && authorUid === comment.comment_author_uid) {
                const btn = document.createElement("button");
                btn.id = comment.comment_id;
                btn.dataset.authoruid = comment.comment_author_uid;
                btn.textContent = "󰆴";
                btn.addEventListener("click", async () => {
                    await deleteComment(authorUid, comment.comment_id);
                });
                div.append(btn);
            }

            commentE.append(div);
            commentsList.append(commentE);
        }
    }

    function onMessage(e: MessageEvent) {
        if (!commentsList || !lineRef) { 
            throw new Error("Unexpected UI error");
        }
        const comments: CommentView[] = JSON.parse(e.data);
        refreshComments(comments);
    }

    const main = document.querySelector("main");
    const stdout = document.getElementById("stdout");
    const caret = document.getElementById("caret");
    if (!main || !stdin || !stdout || !caret)
        throw new Error("Unexpected UI error");

    let stdinBuffer = "";
    main.addEventListener("mouseup", () => stdin.focus());
    main.addEventListener("touchend", () => stdin.focus());
    stdin.focus();

    async function sign() {
        if (!stdout || !stdin) throw new Error("Unexpected UI error");
        const comment = stdout.textContent;

        if (!comment) throw new Error("Unexpected UI error");

        if (comment.trim() !== "" && comment.length >= 2) {
            if (comment.startsWith("\\u0017")) {
                return fetch("/api/auth/logout", { 
                    method: "POST",
                    redirect: "manual"
                }).
                    then(() => {
                        window.location.replace("/guestbook");
                    }).
                    catch((err) => {
                        console.error("Unexpected error during logout");
                    })
            }

            const params = new URLSearchParams();
            params.set("comment", comment);

            const headers: HeadersInit = {
                Accept: "application/json",
                "Content-Type": "application/x-www-form-urlencoded",
            };

            const req: RequestInit = {
                mode: "same-origin",
                body: params,
                method: "POST",
                headers: headers,
            };        

            try {
                const res = await fetch("/api/guestbook", req);
                const latestComments: CommentView[] = await res.json();

                sse.close();
                refreshComments(latestComments);
                sse = new EventSource("/api/guestbook_event");
                sse.addEventListener("message", onMessage);

                stdinBuffer = "";
                stdin.value = "";
                caretPos.caret = 0;
            } catch(e) {
                console.log(e);
            }
        }
    }

    async function onKeyDown(e: KeyboardEvent) {
        if (!e.target)
            throw new Error(`${e.type} event fired with a null target`);
        if (e.altKey || e.ctrlKey || e.metaKey) {
            e.preventDefault();
            return;
        }
        switch (e.key) {
            case "ArrowLeft": {
                if (caretPos.caret <= 0) break;
                caretPos.caret -= 1;
                break;
            }
            case "ArrowRight": {
                if (caretPos.caret >= stdinBuffer.length) break;
                caretPos.caret += 1;
                break;
            }
            case "Enter": {
                await sign();
                break;
            }
        }
    }

    function onInput(e: Event) {
        if (!e.target)
            throw new Error(`${e.type} event fired with a null target`);
        const t = e.target as HTMLInputElement;
        stdinBuffer = t.value;
        caretPos.caret = t.selectionEnd || 0;
    }

    const caretchange = new Event("caret");
    const caretPos = new Proxy({ caret: 0 }, {
        set: (target, prop, newValue, _) => {
            if (prop !== "caret" || typeof newValue !== "number") return false;
            target.caret = newValue;
            stdout.dispatchEvent(caretchange);
            return true;
        }
    });

    function onCaretChange(e: Event) {
        if (!caret) throw new Error("Unexpected UI error");
        if (!e.target)
            throw new Error(`${e.type} event fired with a null target`);
        const t = e.target as HTMLSpanElement;
        t.innerHTML = "";
        caret.innerText = stdinBuffer[caretPos.caret] || " ";
        t.appendChild(caret);
        t.insertAdjacentText("afterbegin", stdinBuffer.slice(0, caretPos.caret));
        t.insertAdjacentText("beforeend", stdinBuffer.slice(caretPos.caret + 1));
    }

    stdin.addEventListener("keydown", onKeyDown);
    stdin.addEventListener("input", onInput);
    stdout.addEventListener(caretchange.type, onCaretChange);
});
</script>
