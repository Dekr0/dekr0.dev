---
export const prerender = true;

import Anchor from "@components/Anchor.astro";
import Header from "@components/Header.astro";
import HistoryPrompt from "@components/HistoryPrompt.astro";
import Line from "@components/Line.astro";
import Zen from "@components/Zen.astro";
import Layout from "@layouts/Layout.astro";

import initLine from "src/line.mts";
import quotes from "src/quote.mts";

import { bolt } from "src/icon.mts";

import { socials } from "src/social.mts";

let line = initLine();
---

<Layout title="Home">
    <Zen>
        <p
            class="pt-2 text-solar-green-500 italic font-mono text-justify text-base"
        >
            "{quotes()}"
        </p>

        <h2 class="text-solar-base-03 bg-solar-base-3 font-bold w-fit px-2">
            Dekr0
        </h2>

        <section id="home" class="flex flex-col gap-4">
            <Line line={line}>
                <HistoryPrompt buffer="man home" />
            </Line>

            <Line line={line}>
                <p>
                    a computer engineer at 
                    <span class="px-1 bg-solar-blue-900 text-solar-red-700">[NULL]</span>, 
                    making things simple, 
                    <a 
                        href="https://www.computerenhance.com/p/table-of-contents"
                        target="_blank"
                        class="text-solar-yellow-500 hover:text-solar-yellow-300 font-bold animate-ease-in-out">
                        blazingly fast {bolt}
                    </a> and 
                    <a
                        href="https://suckless.org/philosophy/"
                        target="_blank"
                        class="text-solar-blue-500 hover:text-solar-blue-300 font-bold animate-ease-in-out">
                        suckless
                    </a>
                </p>
            </Line>
        </section>

        <section id="social" class="flex flex-col gap-4">
            <Line line={line}>
                <HistoryPrompt buffer="man social" />
            </Line>

            <Line line={line}>
                <h2 class="text-solar-blue-300 font-bold w-fit">## Social</h2>
            </Line>
            <ul class="flex flex-col gap-4 content-center">
                {socials.map((social) => 
                <li>
                    <Line line={line}>
                        <Anchor href={social.url}> 
                            <span>{social.icon}</span> <span>{social.text}</span>
                        </Anchor>
                    </Line>
                </li>)}
                <li>
            </ul>
        </section>
    </Zen>
    <Header title="index" />
</Layout>
