---
export const prerender = true;

import Anchor from "@components/Anchor.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import HistoryPrompt from "@components/HistoryPrompt.astro";
import Line from "@components/Line.astro";
import Zen from "@components/Zen.astro";
import Layout from "@layouts/Layout.astro";

import initLine from "src/line.ts";
import quotes from "src/quote.ts";

import { bolt } from "src/icon.ts";

import { socials } from "src/social.ts";

let line = initLine();
---
<Layout title="Home">
    <Zen>
        <p class="pt-2 text-lack-special font-mono text-justify" >
            "{quotes()}"
        </p>
        <h2 class="text-lack-black bg-lack-gray9 w-fit px-2">
            Dekr0
        </h2>
        <Header />
        <section id="home" class="flex flex-col gap-4">
            <Line line={line}>
                <HistoryPrompt buffer="man home" />
            </Line>
            <Line line={line}>
                <p>
                    a computer engineer at 
                    <span class="px-1 text-lack-error">[NULL]</span>, 
                    making things simple, 
                    <a 
                        href="https://www.computerenhance.com/p/table-of-contents"
                        target="_blank"
                        class="text-lack-warn hover:text-lack-warn-high animate-ease-in-out">
                        blazingly fast 
                    </a> and 
                    <a
                        href="https://suckless.org/philosophy/"
                        target="_blank"
                        class="text-lack-hint hover:text-lack-hint-high animate-ease-in-out">
                        suckless
                    </a>
                </p>
            </Line>
        </section>
        <section id="social" class="flex flex-col gap-4">
            <Line line={line}>
                <HistoryPrompt buffer="man social" />
            </Line>

            <Line line={line}>
                <h2 class="text-lack-hint w-fit">## Social</h2>
            </Line>
            <ul class="flex flex-col gap-4 content-center">
                {socials.map((social) => 
                <li>
                    <Line line={line}>
                        <Anchor href={social.url}> 
                            {social.text}
                        </Anchor>
                    </Line>
                </li>)}
                <li>
            </ul>
        </section>
    </Zen>
    <Footer title="index" />
</Layout>
