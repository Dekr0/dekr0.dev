---
import Anchor from "../components/Anchor.astro";
import Header from "../components/Header.astro";
import HistoryPrompt from "../components/HistoryPrompt.astro";
import Line from "../components/Line.astro";
import Zen from "../components/Zen.astro";
import Layout from "../layouts/Layout.astro";

import initLine from "../line.mts";
import quotes from "../quote.mts";

type Social = {
    icon: string
    text: string
    url: string
};

const socials: Socials[] = [
    { 
        icon: "\uf1ff",
        text: "Discord", 
        url: "https://discord.com/invite/un4hz3uZ" 
    },
    { 
        icon: "\udb80\uddee",
        text: "Email", 
        url: "Email - dekr0.dk@protonmail.com" 
    },
    { 
        icon: "\ue708",
        text: "GitHub", 
        url: "https://github.com/Dekr0" 
    },
    { 
        icon: "\udb80\udf3b",
        text: "LinkedIn", 
        url: "linkedin.com/in/chengxuan-li" 
    },
    {
        icon: "\uf35e",
        text: "X",
        url: "https://twitter.com/notDeKr0"
    }
];

let line = initLine();
---

<Layout title="Home">
    <Zen>
        <p
            class="pt-2 text-solar-green-500 italic font-mono text-justify text-base"
        >
            "{quotes()}"
        </p>
        <h2 class="text-solar-base-03 bg-solar-base-3 font-bold w-fit px-2">
            Dekr0
        </h2>
        <section id="home" class="flex flex-col gap-4">
            <Line line={line}>
                <HistoryPrompt buffer="man home" />
            </Line>
            <Line line={line}>
                <p>
                    a computer engineer at <span
                        class="px-1 bg-solar-blue-900 text-solar-red-700"
                        >[NULL]</span
                    >, and a performance, simplicity, and suckless super fan.
                </p>
            </Line>
        </section>
        <section id="social" class="flex flex-col gap-4">
            <Line line={line}>
                <HistoryPrompt buffer="man social" />
            </Line>
            <Line line={line}>
                <h2 class="text-solar-blue-300 font-bold w-fit">## Social</h2>
            </Line>
            <ul class="flex flex-col gap-4 content-center">
                {socials.map((social) => <li>
                    <Line line={line}>
                        <Anchor target={social.url}> 
                            <span>{social.icon}</span> <span>{social.text}</span>
                        </Anchor>
                    </Line>
                </li>)}
                <li>
            </ul>
        </section>
    </Zen>
    <Header title="index" />
</Layout>
