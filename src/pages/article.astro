---
export const prerender = true;

import Header from "@components/Header.astro";
import HistoryPrompt from "@components/HistoryPrompt.astro";
import Line from "@components/Line.astro";
import Layout from "@layouts/Layout.astro";
import Zen from "@components/Zen.astro";

import initLine from "src/line.ts";
import quotes from "src/quote.ts";

let allPosts = undefined;
try {
    allPosts = await Astro.glob("./posts/*.md");
} catch(e) {

}

let line = initLine();
---

<Layout title="Article">
    <Zen>
        <p
            class="pt-2 text-solar-green-500 italic font-mono text-justify text-base"
        >
            "{quotes()}"
        </p>
        <section id="article" class="flex flex-col gap-4 text-justify hide">
            <Line line={line}>
                <HistoryPrompt buffer="man article" />
            </Line>

            <div>
                {allPosts ? 
                <ul>
                    {allPosts.map((post) => 
                        <li>
                            <Line line={line}>
                                <a 
                                    class="text-solar-cyna-500 hover:text-solar-cyna-300"
                                    href={post.url}>
                                    {post.frontmatter.title}
                                </a>
                            </Line>
                        </li>)}
                </ul> : 
                <Line line={line}>
                    <p>I haven't written any articles yet ... :(</p>
                </Line>
                }
            </div>
        </section>
    </Zen>
    <Header title="article" />
</Layout>
