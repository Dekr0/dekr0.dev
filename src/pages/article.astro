---
import Header from "../components/Header.astro";
import HistoryPrompt from "../components/HistoryPrompt.astro";
import Line from "../components/Line.astro";
import Layout from "../layouts/Layout.astro";
import Zen from "../components/Zen.astro";

import quotes from "../quote.mts";

let line = 0;
---

<Layout title="Article">
    <Zen>
        <p
            class="pt-2 text-solar-green-500 italic font-mono text-justify text-base"
        >
            "{quotes()}"
        </p>
        <section id="article" class="flex flex-col gap-4 text-justify hide">
            <Line line={line++}>
                <HistoryPrompt buffer="man article" />
            </Line>
            <Line line={line++}>
                <p>I haven't written any article yet {`\udb83\udd12`}...</p>
            </Line>
        </section>
    </Zen>
    <Header title="article" />
</Layout>
