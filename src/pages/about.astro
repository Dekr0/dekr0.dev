---
export const prerender = true;

import Anchor from "@components/Anchor.astro";
import HistoryPrompt from "@components/HistoryPrompt.astro";
import Header from "@components/Header.astro";
import Line from "@components/Line.astro";
import Layout from "@layouts/Layout.astro";
import Zen from "@components/Zen.astro";

import initLine from "src/line.ts";
import quotes from "src/quote.ts";
import { learning, reading, working } from "src/status.ts";

let line = initLine();
---
<Layout title="About">
    <Zen>
        <p
            class="pt-2 text-solar-green-500 italic font-mono text-justify text-base"
        >
            "{quotes()}"
        </p>
        <section id="about" class="flex flex-col gap-4 text-justify hide">
            <Line line={line}>
                <HistoryPrompt buffer="man about" />
            </Line>

            <Line line={line}>
                <h1 class="text-solar-blue-300 font-bold w-fit">
                    # Hello
                </h1>
            </Line>

            <Line line={line}>
                <h2 class="text-solar-blue-300 font-bold w-fit">
                    ## My Name is Chason Li.
                </h2>
            </Line>

            <Line line={line}>
                <p>
                    I'm a computer engineer at [unemployed] comfortable with 
                    frontend and backend development.
                </p>
            </Line>

            <Line line={line}>
                <p>I'm currently learning:</p>
            </Line>
            {learning.map((e, i, a) => 
                <Line line={line}>
                    <p class="ml-8">
                         {i == a.length - 1 ? "and" : ""}
                        {e.url ? <Anchor href={e.url}>{e.name}</Anchor> : e.name}{i == a.length - 1 ? "." : ","}
                    </p>
                </Line>
            )}

            <Line line={line}>
                <p>I'm currently reading:</p>
            </Line>
            {reading.map((e, i, a) => 
                <Line line={line}>
                    <p class="ml-8">
                         {i == a.length - 1 ? "and" : ""}
                        {e.url ? <Anchor href={e.url}>{e.name}</Anchor> : e.name}{i == a.length - 1 ? "." : ","}
                    </p>
                </Line>
            )}

            <Line line={line}>
                <p>I'm currently working on:</p>
            </Line>
            {working.map((e, i, a) => 
                <Line line={line}>
                    <p class="ml-8">
                         {i == a.length - 1 ? "and" : ""}
                        {e.url ? <Anchor href={e.url}>{e.name}</Anchor> : e.name}{i == a.length - 1 ? "." : ","}
                    </p>
                </Line>
            )}

            <Line line={line}>
                <p>I’m currently based in Canada.</p>
            </Line>

            <Line line={line}>
                <p>
                    You can message me via my 
                    <a
                        id="social-anchor"
                        class="bg-solar-base-3 text-solar-base-03 px-2 hover:bg-solar-green-700 font-bold animate-ease-in-out"
                        href="/">
                        Social</a>.
                </p>
            </Line>
        </section>
    </Zen>
    <Header title="about" />
</Layout>
