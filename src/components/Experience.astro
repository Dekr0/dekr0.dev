---
import Line from "../components/Line.astro";
import HistoryPrompt from "./HistoryPrompt.astro";

let line = 0;
---
<section id="experience" class="flex flex-col gap-4">
    <Line line={line++}>
        <HistoryPrompt buffer="man experience"/>
    </Line>
    <Line line={line++}>
        <h2 class="text-solar-blue-300 font-bold w-fit">## Experience</h2>
    </Line>
    <ul class="flex gap-4">
        <Line line={line++}>
            <li>University of Alberta - Bachelor of Science In Computer Engineering</li>
        </Line>
    </ul>
</section>
