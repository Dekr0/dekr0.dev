---
export const prerender = true;

import { bolt, pulse } from "../icon.ts";

interface Props {
    buffer: string;
}

const start = Date.now();
const { buffer } = Astro.props;
---
<div class="flex flex-wrap gap-2 items-center">
    <div class="flex gap-2 basis-full items-center">
        <span class="text-solar-yellow-300">{bolt}</span>
        <span class="text-solar-green-700 px-3">
            {((Date.now() - start) / 1000).toPrecision(4)} s
        </span>
    </div>
    <p class="text-solar-base-1">
        <span class="text-solar-yellow-500 text-2xl">{pulse}</span> {buffer}
    </p>
</div>
