---
interface Props {
    title: string;
    ext?: string;
}

const { title, ext } = Astro.props;
let icon = " markdown";
if (ext?.endsWith("tsx") || ext?.endsWith("jsx")) {
    icon = " solid";
}
---

<footer
    class="mx-auto py-4 text-sm w-full font-mono text-solar-base-1 selection:bg-solar-base-1 selection:text-solar-base-04"
>
    <nav
        class="font-semibold w-full fixed bottom-0 selection:bg-solar-base-03 selection:text-solar-base-3 text-xs xs:text-base lg:text-lg"
    >
        <ul class="flex text-solar-base-03 bg-solar-base-02">
            <li
                class="px-2 bg-solar-blue-700 text-solar-base-04 animate-ease-in-out tracking-wide"
            >
                 <span class="hidden sm:inline">NORMAL</span>
            </li>
            <li
                class="px-2 bg-solar-base-3 hover:bg-solar-green-700 animate-ease-in-out"
            >
                <a href="/">Home</a>
            </li>
            <li
                class="px-2 bg-solar-base-3 hover:bg-solar-green-700 animate-ease-in-out"
            >
                <a href="/about">About</a>
            </li>
            <li
                class="px-2 bg-solar-base-3 hover:bg-solar-green-700 animate-ease-in-out"
            >
                <a href="/article">Article</a>
            </li>
            <li
                class="px-2 bg-solar-base-3 hover:bg-solar-green-700 animate-ease-in-out"
            >
                <a href="/experience">Experience</a>
            </li>
            <li
                class="px-2 bg-solar-base-3 hover:bg-solar-green-700 animate-ease-in-out"
            >
                <a href="/project">Project</a>
            </li>
            <li
                class="px-2 hidden sm:block mr-auto text-solar-base-3 font-thin animate-ease-in-out tracking-wide"
            >
                {title}.{ext || "md"}
            </li>
            <li
                class="px-2 hidden md:block text-solar-base-3 font-thin animate-ease-in-out tracking-wide"
            >
                utf-8
            </li>
            <li
                class="px-2 hidden md:block text-solar-base-3 font-normal animate-ease-in-out tracking-wide"
            >
                󰣇
            </li>
            <li
                class="px-2 hidden sm:block text-solar-base-3 font-normal animate-ease-in-out tracking-wide"
            >
                {icon}
            </li>
        </ul>
        <div class="bg-solar-base-04">
            <a class="text-solar-orange-500 ml-0.5 mb-1.5" href="/ssh"
                >:ssh dekr0.de<span
                    class="text-solar-base-04 bg-solar-base-3 animate-pulse"
                    >v</span
                ></a
            >
        </div>
    </nav>
</footer>
