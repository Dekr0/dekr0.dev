---
export const prerender = true;

interface Props {
    line: () => number;
}
const { line } = Astro.props;
---
<div tabindex="0" class="flex gap-4 md:gap-8 lg:gap-10 ml-2 items-center text-lack-gray4 hover:text-lack-gray7 hover:bg-lack-gray2 animate-ease-in-out">
    <span class="ml-2 text-center self-start">{line()}</span>
    <slot />
</div>
