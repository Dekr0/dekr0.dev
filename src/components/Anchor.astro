---
export const prerender = true;

interface Props {
    href: string
    notblank?: boolean
}
const { href, notblank } = Astro.props;
---
<a 
    class="text-center underline underline-offset-2 text-solar-cyna-500 hover:text-solar-cyna-300 animate-ease-in-out"
    href={href}
    target={notblank ? "" : "_blank"}>
    <slot /></a>
