---
export const prerender = true;

interface Props {
    href: string
    notblank?: boolean
}
const { href, notblank } = Astro.props;
---
<a 
    class="text-center underline underline-offset-2 text-lack-special hover:text-lack-special-high animate-ease-in-out"
    href={href}
    target={notblank ? "" : "_blank"}>
    <slot />
</a>
