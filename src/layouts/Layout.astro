---
export const prerender = true;

interface Props {
    title: string;
    css?: string[];
}

const { title, css } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="stylesheet" href="node_modules/@xterm/xterm/css/xterm.css" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body class="font-mono bg-lack-gray0 selection:bg-lack-gray9 selection:text-lack-black">
        <slot />
    </body>
</html>

<style is:global>
    @tailwind components;

    @layer components {
        .animate-ease-in-out {
            transition:
                background-color 500ms ease-in-out,
                color 500ms ease-in-out;
        }
    }

    @font-face {
        font-family: "mono";
        src: url("/fonts/Iosevka-Extended.ttf")
            format("truetype");
        font-weight: normal;
        font-style: normal;
        font-display: swap;
    }
</style>
